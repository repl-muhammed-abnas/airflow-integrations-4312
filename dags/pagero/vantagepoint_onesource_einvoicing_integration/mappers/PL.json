{
  "_meta": {
    "version": "1.0",
    "description": "Poland PUF mapper - VAT compliant with KSeF support",
    "inherits": "_base.json",
    "last_updated": "2026-01-18",
    "compliance": ["EN16931", "Peppol BIS 3.0", "Polish VAT", "KSeF"]
  },

  "country": {
    "code": "PL",
    "name": "Poland",
    "currency": "PLN",
    "language": "pl"
  },

  "tax_system": {
    "type": "VAT",
    "scheme_id": "VAT",
    "rates": {
      "standard": 23.0,
      "reduced": [5.0, 8.0],
      "zero": 0.0
    },
    "tax_categories": {
      "S": "Stawka podstawowa",
      "AA": "Stawka obnizona",
      "Z": "Stawka zerowa",
      "E": "Zwolniony",
      "AE": "Odwrotne obciazenie",
      "K": "Wewnatrzwspolnotowa dostawa",
      "G": "Eksport"
    },
    "exemption_code_defaults": {
      "E": "VATEX-EU-132",
      "Z": "VATEX-EU-Z",
      "AE": "VATEX-EU-AE",
      "K": "VATEX-EU-IC",
      "G": "VATEX-EU-G",
      "O": "VATEX-EU-O"
    }
  },

  "identifiers": {
    "seller_endpoint_scheme": "9945",
    "buyer_endpoint_scheme": "9945",
    "vat_scheme_id": "9945",
    "company_scheme_id": "0213",
    "vat_prefix": "PL",
    "scheme_mappings": {
      "vat_number": "9945",
      "nip": "9945",
      "regon": "0213",
      "krs": "0213",
      "gln": "0088"
    },
    "additional_seller_ids": {
      "nip": "9945",
      "regon": "0213",
      "krs": "0213"
    },
    "additional_buyer_ids": {
      "nip": "9945"
    }
  },

  "extensions": {
    "required": ["PL:KSeF"],
    "optional": ["PL:GTU", "PL:TP", "PL:SW"],
    "ksef": {
      "enabled": true,
      "mandatory_from": "2026-02-01",
      "registration_data": {
        "ksef_number": {
          "id_type": "PL:KSeFNumber",
          "description": "KSeF invoice number assigned by system"
        },
        "session_token": {
          "id_type": "PL:SessionToken",
          "description": "KSeF session authentication token"
        }
      }
    },
    "gtu_codes": {
      "id_type": "PL:GTU",
      "description": "Goods and Services Type codes for JPK_VAT",
      "codes": {
        "GTU_01": "Alcoholic beverages",
        "GTU_02": "Fuel and lubricants",
        "GTU_03": "Heating oil",
        "GTU_04": "Tobacco products",
        "GTU_05": "Waste materials",
        "GTU_06": "Electronic devices",
        "GTU_07": "Vehicles",
        "GTU_08": "Precious metals",
        "GTU_09": "Medicines",
        "GTU_10": "Buildings",
        "GTU_11": "Greenhouse gas emission allowances",
        "GTU_12": "Intangible services",
        "GTU_13": "Transport services"
      }
    },
    "transaction_markers": {
      "tp": {
        "id_type": "PL:TP",
        "description": "Related party transaction marker"
      },
      "sw": {
        "id_type": "PL:SW",
        "description": "Mail order/distance sale marker"
      },
      "ee": {
        "id_type": "PL:EE",
        "description": "Telecommunications/electronic services"
      },
      "mpp": {
        "id_type": "PL:MPP",
        "description": "Split payment mechanism required"
      }
    }
  },

  "field_mappings": {
    "additional_header_fields": {
      "ksef_number": "KSeFNumber",
      "gtu_codes": "GTUCodes",
      "transaction_markers": "TransactionMarkers"
    },
    "additional_seller_fields": {
      "nip": "SellerNIP",
      "regon": "SellerREGON",
      "krs": "SellerKRS"
    },
    "additional_buyer_fields": {
      "nip": "BuyerNIP"
    }
  },

  "validation_rules": {
    "vat_number_pattern": "^PL[0-9]{10}$",
    "nip_pattern": "^[0-9]{10}$",
    "regon_pattern": "^[0-9]{9}([0-9]{5})?$",
    "krs_pattern": "^[0-9]{10}$",
    "postal_code_pattern": "^[0-9]{2}-[0-9]{3}$",
    "iban_pattern": "^PL[0-9]{26}$",
    "required_fields": [
      "invoice_number",
      "issue_date",
      "currency_code",
      "seller_vat_number",
      "seller_nip"
    ]
  },

  "defaults": {
    "payment_terms": "Platnosc w ciagu 30 dni",
    "contact_department": "Dzial Ksiegowosci"
  },

  "special_rules": {
    "requires_issue_time": true,
    "requires_duty_stamp": false,
    "requires_fiscal_code": false,
    "ksef_mandatory": true,
    "split_payment_required_threshold": 15000,
    "split_payment_currency": "PLN",
    "gtu_classification_required": true,
    "jpk_vat_reporting": true
  },

  "translations": {
    "invoice": "Faktura",
    "credit_note": "Faktura korygujaca",
    "total": "Razem",
    "vat": "VAT"
  }
}
