{
  "_meta": {
    "version": "1.0",
    "description": "Austria PUF mapper - USt compliant",
    "inherits": "_base.json",
    "last_updated": "2026-02-11",
    "compliance": ["EN16931", "Peppol BIS 3.0", "Austrian VAT", "ebInterface"]
  },

  "country": {
    "code": "AT",
    "name": "Austria",
    "currency": "EUR",
    "language": "de"
  },

  "tax_system": {
    "type": "VAT",
    "scheme_id": "VAT",
    "rates": {
      "standard": 20.0,
      "reduced": [10.0, 13.0],
      "zero": 0.0
    },
    "tax_categories": {
      "S": "Normalsteuersatz",
      "AA": "Ermaessigter Steuersatz",
      "Z": "Nullsatz",
      "E": "Steuerbefreit",
      "AE": "Umgekehrte Steuerschuldnerschaft",
      "K": "Innergemeinschaftliche Lieferung",
      "G": "Ausfuhrlieferung"
    }
  },

  "identifiers": {
    "seller_endpoint_scheme": "9915",
    "buyer_endpoint_scheme": "9915",
    "vat_scheme_id": "9915",
    "company_scheme_id": "9915",
    "vat_prefix": "AT",
    "scheme_mappings": {
      "vat_number": "9915",
      "gln": "0088"
    }
  },

  "extensions": {
    "required": [],
    "optional": [],
    "ebinterface": {
      "supported": true,
      "public_sector": true
    }
  },

  "validation_rules": {
    "vat_number_pattern": "^ATU[0-9]{8}$",
    "postal_code_pattern": "^[0-9]{4}$",
    "iban_pattern": "^AT[0-9]{18}$",
    "required_fields": ["invoice_number", "issue_date", "currency_code", "seller_vat_number"]
  },

  "defaults": {
    "payment_terms": "Zahlbar innerhalb von 30 Tagen",
    "contact_department": "Buchhaltung"
  },

  "special_rules": {
    "requires_issue_time": false,
    "requires_duty_stamp": false,
    "requires_fiscal_code": false
  },

  "translations": {
    "invoice": "Rechnung",
    "credit_note": "Gutschrift",
    "total": "Gesamtbetrag",
    "vat": "USt"
  }
}
