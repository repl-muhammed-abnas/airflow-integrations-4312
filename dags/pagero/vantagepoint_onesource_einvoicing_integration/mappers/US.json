{
  "_meta": {
    "version": "1.0",
    "description": "United States PUF mapper - Sales Tax compliant",
    "inherits": "_base.json",
    "last_updated": "2026-01-18",
    "compliance": ["Peppol BIS 3.0"]
  },

  "country": {
    "code": "US",
    "name": "United States",
    "currency": "USD",
    "language": "en"
  },

  "tax_system": {
    "type": "SalesTax",
    "scheme_id": "SalesTax",
    "rates": {
      "federal": 0.0,
      "state_range": [0.0, 10.0],
      "zero": 0.0
    },
    "tax_categories": {
      "S": "Taxable",
      "Z": "Non-taxable",
      "E": "Exempt"
    },
    "notes": "Sales tax varies by state, county, and municipality"
  },

  "identifiers": {
    "seller_endpoint_scheme": "0060",
    "buyer_endpoint_scheme": "0060",
    "vat_scheme_id": "0060",
    "company_scheme_id": "0060",
    "scheme_mappings": {
      "ein": "0060",
      "duns": "0060",
      "gln": "0088"
    }
  },

  "extensions": {
    "required": [],
    "optional": []
  },

  "validation_rules": {
    "vat_number_pattern": "^[0-9]{2}-[0-9]{7}$",
    "ein_pattern": "^[0-9]{2}-[0-9]{7}$",
    "postal_code_pattern": "^[0-9]{5}(-[0-9]{4})?$",
    "required_fields": ["invoice_number", "issue_date", "currency_code"]
  },

  "defaults": {
    "payment_terms": "Net 30 days",
    "contact_department": "Accounts Payable"
  },

  "special_rules": {
    "requires_issue_time": false,
    "requires_duty_stamp": false,
    "requires_fiscal_code": false,
    "multi_tax_jurisdiction": true,
    "nexus_based_taxation": true
  },

  "translations": {
    "invoice": "Invoice",
    "credit_note": "Credit Memo",
    "total": "Total",
    "tax": "Sales Tax"
  }
}
