{
  "_meta": {
    "version": "1.0",
    "description": "Italy PUF mapper - FatturaPA compatible",
    "inherits": "_base.json",
    "last_updated": "2025-01-01",
    "compliance": ["EN16931", "FatturaPA", "SDI", "Peppol BIS 3.0"]
  },

  "country": {
    "code": "IT",
    "name": "Italy",
    "currency": "EUR",
    "language": "it"
  },

  "tax_system": {
    "type": "VAT",
    "scheme_id": "VAT",
    "rates": {
      "standard": 22.0,
      "reduced": [10.0],
      "super_reduced": [4.0, 5.0],
      "zero": 0.0
    },
    "tax_categories": {
      "S": "Aliquota ordinaria",
      "AA": "Aliquota ridotta",
      "Z": "Aliquota zero",
      "E": "Esente",
      "AE": "Inversione contabile"
    },
    "natura_codes": {
      "N1": "Escluse ex art. 15",
      "N2.1": "Non soggette ad IVA - art. 7",
      "N2.2": "Non soggette - altri casi",
      "N3.1": "Non imponibili - esportazioni",
      "N3.2": "Non imponibili - cessioni intracomunitarie",
      "N3.3": "Non imponibili - cessioni San Marino",
      "N3.4": "Non imponibili - operazioni assimilate",
      "N3.5": "Non imponibili - dichiarazioni intento",
      "N3.6": "Non imponibili - altre operazioni",
      "N4": "Esenti",
      "N5": "Regime del margine/IVA non esposta",
      "N6.1": "Inversione contabile - cessione rottami",
      "N6.2": "Inversione contabile - cessione oro",
      "N6.3": "Inversione contabile - subappalto edile",
      "N6.4": "Inversione contabile - cessione fabbricati",
      "N6.5": "Inversione contabile - cessione cellulari",
      "N6.6": "Inversione contabile - cessione prodotti elettronici",
      "N6.7": "Inversione contabile - prestazioni settore edile",
      "N6.8": "Inversione contabile - operazioni energetiche",
      "N6.9": "Inversione contabile - altri casi",
      "N7": "IVA assolta in altro stato UE"
    }
  },

  "identifiers": {
    "seller_endpoint_scheme": "0201",
    "buyer_endpoint_scheme": "0201",
    "vat_scheme_id": "9906",
    "fiscal_code_scheme_id": "0210",
    "company_scheme_id": "0201",
    "vat_prefix": "IT",
    "scheme_mappings": {
      "vat_number": "9906",
      "fiscal_code": "0210",
      "codice_destinatario": "0201",
      "pec": "0202",
      "gln": "0088"
    }
  },

  "extensions": {
    "required": [
      "IT:Ufficio",
      "IT:NumeroREA",
      "IT:CapitaleSociale",
      "IT:SocioUnico",
      "IT:StatoLiquidazione"
    ],
    "optional": ["IT:TaxChargeability", "IT:DutyStamp"],
    "registration_data": {
      "ufficio": {
        "id_type": "IT:Ufficio",
        "description": "Province registration code (2 chars)",
        "required": true,
        "pattern": "^[A-Z]{2}$"
      },
      "numero_rea": {
        "id_type": "IT:NumeroREA",
        "description": "Company register number",
        "required": true
      },
      "capitale_sociale": {
        "id_type": "IT:CapitaleSociale",
        "description": "Share capital amount",
        "required_for": ["SpA", "SApA", "SRL", "Srl"]
      },
      "socio_unico": {
        "id_type": "IT:SocioUnico",
        "description": "Shareholder type",
        "values": {
          "SU": "Sole shareholder",
          "SM": "Multiple shareholders"
        },
        "default": "SM"
      },
      "stato_liquidazione": {
        "id_type": "IT:StatoLiquidazione",
        "description": "Liquidation status",
        "values": {
          "LS": "In liquidation",
          "LN": "Not in liquidation"
        },
        "default": "LN"
      }
    },
    "tax_chargeability": {
      "id_type": "IT:TaxChargeability",
      "values": {
        "I": "Immediate",
        "D": "Deferred",
        "S": "Split payment"
      },
      "default": "I"
    },
    "duty_stamp": {
      "threshold": 77.47,
      "amount": 2.00,
      "currency": "EUR",
      "applies_to": "exempt_invoices"
    }
  },

  "dual_tax_scheme": {
    "enabled": true,
    "primary": {
      "type": "VAT",
      "id": "Partita IVA",
      "format": "IT[0-9]{11}"
    },
    "secondary": {
      "type": "TAX",
      "id": "Codice Fiscale",
      "format": "[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]|[0-9]{11}"
    }
  },

  "field_mappings": {
    "additional_buyer_fields": {
      "buyer_fiscal_code": "BuyerFiscalCode",
      "codice_destinatario": "BuyerCodiceDestinatario",
      "pec_address": "BuyerPECAddress"
    },
    "additional_seller_fields": {
      "seller_fiscal_code": "SellerFiscalCode",
      "ufficio": "SellerUfficio",
      "numero_rea": "SellerNumeroREA",
      "capitale_sociale": "SellerCapitaleSociale"
    }
  },

  "validation_rules": {
    "vat_number_pattern": "^IT[0-9]{11}$",
    "fiscal_code_pattern": "^[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]$|^[0-9]{11}$",
    "codice_destinatario_pattern": "^[A-Z0-9]{7}$",
    "postal_code_pattern": "^[0-9]{5}$",
    "iban_pattern": "^IT[0-9]{2}[A-Z][0-9]{22}$",
    "required_fields": [
      "invoice_number",
      "issue_date",
      "currency_code",
      "seller_vat_number",
      "buyer_codice_destinatario"
    ],
    "vat_rates_allowed": [0, 4, 5, 10, 22]
  },

  "defaults": {
    "payment_terms": "90 giorni data fattura",
    "contact_department": "Ufficio Contabilita",
    "socio_unico": "SM",
    "stato_liquidazione": "LN",
    "tax_chargeability": "I"
  },

  "special_rules": {
    "requires_issue_time": false,
    "requires_duty_stamp": true,
    "requires_fiscal_code": true,
    "requires_registration_data": true,
    "requires_tax_chargeability": true,
    "dual_tax_scheme": true,
    "sdi_routing": true
  },

  "translations": {
    "invoice": "Fattura",
    "credit_note": "Nota di Credito",
    "total": "Totale",
    "vat": "IVA",
    "exempt": "Esente"
  }
}
