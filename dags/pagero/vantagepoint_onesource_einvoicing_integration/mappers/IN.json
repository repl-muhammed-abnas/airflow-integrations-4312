{
  "_meta": {
    "version": "1.0",
    "description": "India PUF mapper - GST compliant with full e-Invoice support",
    "inherits": "_base.json",
    "last_updated": "2026-01-18",
    "compliance": ["Peppol BIS 3.0", "Indian GST", "e-Invoice", "e-Way Bill"]
  },

  "country": {
    "code": "IN",
    "name": "India",
    "currency": "INR",
    "language": "en"
  },

  "tax_system": {
    "type": "GST",
    "scheme_id": "GST",
    "dual_tax": true,
    "rates": {
      "igst": [0.0, 0.25, 3.0, 5.0, 12.0, 18.0, 28.0],
      "cgst": [0.0, 0.125, 1.5, 2.5, 6.0, 9.0, 14.0],
      "sgst": [0.0, 0.125, 1.5, 2.5, 6.0, 9.0, 14.0],
      "utgst": [0.0, 0.125, 1.5, 2.5, 6.0, 9.0, 14.0],
      "cess": [0.0, 1.0, 3.0, 5.0, 12.0, 15.0, 22.0]
    },
    "tax_categories": {
      "S": "Standard rate",
      "Z": "Zero rated",
      "E": "Exempt",
      "O": "Non-GST"
    },
    "supply_type": {
      "B2B": "Business to Business",
      "B2C": "Business to Consumer",
      "B2G": "Business to Government",
      "SEZWP": "SEZ with payment",
      "SEZWOP": "SEZ without payment",
      "EXPWP": "Export with payment",
      "EXPWOP": "Export without payment",
      "DEXP": "Deemed Export"
    }
  },

  "identifiers": {
    "seller_endpoint_scheme": "IN:GSTIN",
    "buyer_endpoint_scheme": "IN:GSTIN",
    "vat_scheme_id": "IN:GSTIN",
    "company_scheme_id": "IN:CIN",
    "scheme_mappings": {
      "gstin": "IN:GSTIN",
      "pan": "IN:PAN",
      "cin": "IN:CIN",
      "gln": "0088"
    },
    "additional_seller_ids": {
      "gstin": "IN:GSTIN",
      "pan": "IN:PAN"
    },
    "additional_buyer_ids": {
      "gstin": "IN:GSTIN",
      "pan": "IN:PAN"
    }
  },

  "extensions": {
    "required": ["IN:SupplyType", "IN:POS"],
    "optional": ["IN:ReverseCharge", "IN:IGST", "IN:CGST", "IN:SGST", "IN:Cess", "IN:eWayBill"],
    "registration_data": {
      "supply_type": {
        "id_type": "IN:SupplyType",
        "description": "Type of supply (B2B, B2C, B2G, etc.)",
        "required": true,
        "values": ["B2B", "B2C", "B2G", "SEZWP", "SEZWOP", "EXPWP", "EXPWOP", "DEXP"]
      },
      "pos_code": {
        "id_type": "IN:POS",
        "description": "Place of Supply state code (01-37)",
        "required": true,
        "pattern": "^[0-9]{2}$"
      },
      "reverse_charge": {
        "id_type": "IN:ReverseCharge",
        "description": "Reverse charge applicable (Y/N)",
        "values": ["Y", "N"],
        "default": "N"
      },
      "item_type": {
        "id_type": "IN:ItemType",
        "description": "GOODS or SERVICE",
        "values": ["GOODS", "SERVICE"]
      }
    },
    "tax_extensions": {
      "igst": {
        "id_type": "IN:IGST",
        "description": "Integrated GST for inter-state"
      },
      "cgst": {
        "id_type": "IN:CGST",
        "description": "Central GST for intra-state"
      },
      "sgst": {
        "id_type": "IN:SGST",
        "description": "State GST for intra-state"
      },
      "cess": {
        "id_type": "IN:Cess",
        "description": "GST Compensation Cess"
      }
    },
    "eway_bill": {
      "required_threshold": 50000,
      "currency": "INR",
      "distance_required": true
    }
  },

  "field_mappings": {
    "additional_header_fields": {
      "supply_type": "SupplyType",
      "pos_code": "PlaceOfSupply",
      "reverse_charge": "ReverseCharge"
    },
    "additional_seller_fields": {
      "gstin": "SellerGSTIN",
      "pan": "SellerPAN",
      "state_code": "SellerStateCode"
    },
    "additional_buyer_fields": {
      "gstin": "BuyerGSTIN",
      "pan": "BuyerPAN",
      "state_code": "BuyerStateCode",
      "pos": "BuyerPOS"
    },
    "additional_line_fields": {
      "hsn_code": "HSNCode",
      "item_type": "ItemType",
      "cess_rate": "CessRate",
      "cess_amount": "CessAmount"
    }
  },

  "validation_rules": {
    "gstin_pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[A-Z0-9]{1}Z[A-Z0-9]{1}$",
    "pan_pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
    "state_code_pattern": "^(0[1-9]|[1-2][0-9]|3[0-7])$",
    "hsn_pattern": "^[0-9]{4,8}$",
    "postal_code_pattern": "^[0-9]{6}$",
    "required_fields": [
      "invoice_number",
      "issue_date",
      "currency_code",
      "seller_gstin",
      "buyer_gstin",
      "supply_type",
      "pos_code"
    ],
    "state_codes": {
      "01": "Jammu and Kashmir",
      "02": "Himachal Pradesh",
      "03": "Punjab",
      "04": "Chandigarh",
      "05": "Uttarakhand",
      "06": "Haryana",
      "07": "Delhi",
      "08": "Rajasthan",
      "09": "Uttar Pradesh",
      "10": "Bihar",
      "11": "Sikkim",
      "12": "Arunachal Pradesh",
      "13": "Nagaland",
      "14": "Manipur",
      "15": "Mizoram",
      "16": "Tripura",
      "17": "Meghalaya",
      "18": "Assam",
      "19": "West Bengal",
      "20": "Jharkhand",
      "21": "Odisha",
      "22": "Chhattisgarh",
      "23": "Madhya Pradesh",
      "24": "Gujarat",
      "26": "Dadra and Nagar Haveli and Daman and Diu",
      "27": "Maharashtra",
      "28": "Andhra Pradesh (Old)",
      "29": "Karnataka",
      "30": "Goa",
      "31": "Lakshadweep",
      "32": "Kerala",
      "33": "Tamil Nadu",
      "34": "Puducherry",
      "35": "Andaman and Nicobar Islands",
      "36": "Telangana",
      "37": "Andhra Pradesh",
      "38": "Ladakh"
    }
  },

  "defaults": {
    "payment_terms": "Net 30 days",
    "contact_department": "Accounts Department",
    "supply_type": "B2B",
    "reverse_charge": "N"
  },

  "special_rules": {
    "requires_issue_time": true,
    "requires_duty_stamp": false,
    "requires_fiscal_code": false,
    "dual_gst_system": true,
    "hsn_code_mandatory": true,
    "pos_determines_tax_type": true,
    "e_invoice_mandatory": true,
    "irn_required": true,
    "qr_code_required": true
  },

  "translations": {
    "invoice": "Tax Invoice",
    "credit_note": "Credit Note",
    "total": "Total",
    "tax": "GST"
  }
}
