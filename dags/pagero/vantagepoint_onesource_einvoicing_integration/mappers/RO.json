{
  "_meta": {
    "version": "1.0",
    "description": "Romania PUF mapper - TVA compliant with e-Factura/RO e-Invoice",
    "inherits": "_base.json",
    "last_updated": "2026-01-18",
    "compliance": ["EN16931", "Peppol BIS 3.0", "Romanian VAT", "e-Factura", "RO e-Invoice"]
  },

  "country": {
    "code": "RO",
    "name": "Romania",
    "currency": "RON",
    "language": "ro"
  },

  "tax_system": {
    "type": "VAT",
    "scheme_id": "VAT",
    "rates": {
      "standard": 19.0,
      "reduced": [5.0, 9.0],
      "zero": 0.0
    },
    "tax_categories": {
      "S": "Cota standard",
      "AA": "Cota redusa",
      "Z": "Cota zero",
      "E": "Scutit",
      "AE": "Taxare inversa",
      "K": "Livrare intracomunitara",
      "G": "Export"
    }
  },

  "identifiers": {
    "seller_endpoint_scheme": "9947",
    "buyer_endpoint_scheme": "9947",
    "vat_scheme_id": "9947",
    "company_scheme_id": "9947",
    "vat_prefix": "RO",
    "scheme_mappings": {
      "vat_number": "9947",
      "cui": "9947",
      "cif": "9947",
      "gln": "0088"
    }
  },

  "extensions": {
    "required": ["RO:eFactura"],
    "optional": ["RO:TaxRepresentative"],
    "efactura": {
      "enabled": true,
      "mandatory": true,
      "spv_integration": true,
      "registration_data": {
        "upload_index": {
          "id_type": "RO:UploadIndex",
          "description": "e-Factura SPV upload index"
        },
        "download_id": {
          "id_type": "RO:DownloadId",
          "description": "e-Factura download identifier"
        },
        "stare": {
          "id_type": "RO:Stare",
          "description": "Invoice status in SPV",
          "values": ["VALID", "IN_PRELUCRARE", "INVALID", "REFUZAT"]
        }
      }
    },
    "bucharest_special": {
      "description": "Bucharest (RO-B) has special requirements",
      "sector_required": true
    }
  },

  "field_mappings": {
    "additional_seller_fields": {
      "cui": "SellerCUI",
      "j_number": "SellerJNumber"
    },
    "additional_buyer_fields": {
      "cui": "BuyerCUI"
    }
  },

  "validation_rules": {
    "vat_number_pattern": "^RO[0-9]{2,10}$",
    "cui_pattern": "^[0-9]{2,10}$",
    "cif_pattern": "^RO[0-9]{2,10}$",
    "j_number_pattern": "^J[0-9]{2}/[0-9]+/[0-9]{4}$",
    "postal_code_pattern": "^[0-9]{6}$",
    "iban_pattern": "^RO[0-9]{2}[A-Z]{4}[A-Z0-9]{16}$",
    "required_fields": [
      "invoice_number",
      "issue_date",
      "currency_code",
      "seller_vat_number",
      "seller_cui"
    ],
    "county_codes": "ISO 3166-2:RO"
  },

  "defaults": {
    "payment_terms": "Plata in 30 de zile",
    "contact_department": "Departament Contabilitate"
  },

  "special_rules": {
    "requires_issue_time": true,
    "requires_duty_stamp": false,
    "requires_fiscal_code": true,
    "efactura_mandatory": true,
    "spv_submission_required": true,
    "bucharest_sector_required": true,
    "county_code_iso_3166_2": true
  },

  "translations": {
    "invoice": "Factura",
    "credit_note": "Factura de stornare",
    "total": "Total",
    "vat": "TVA"
  }
}
