{
  "_meta": {
    "version": "1.0",
    "description": "Singapore PUF mapper - GST compliant",
    "inherits": "_base.json",
    "last_updated": "2026-01-18",
    "compliance": ["Peppol BIS 3.0", "Singapore GST", "InvoiceNow"]
  },

  "country": {
    "code": "SG",
    "name": "Singapore",
    "currency": "SGD",
    "language": "en"
  },

  "tax_system": {
    "type": "GST",
    "scheme_id": "GST",
    "rates": {
      "standard": 9.0,
      "zero": 0.0
    },
    "tax_categories": {
      "S": "Standard-rated",
      "Z": "Zero-rated",
      "E": "Exempt",
      "O": "Out of scope"
    },
    "exemption_code_defaults": {
      "E": "VATEX-SG-EXE",
      "O": "VATEX-SG-OOS"
    }
  },

  "identifiers": {
    "seller_endpoint_scheme": "0195",
    "buyer_endpoint_scheme": "0195",
    "vat_scheme_id": "0195",
    "company_scheme_id": "0195",
    "scheme_mappings": {
      "uen": "0195",
      "gst_number": "0195",
      "gln": "0088"
    }
  },

  "extensions": {
    "required": [],
    "optional": []
  },

  "validation_rules": {
    "vat_number_pattern": "^[A-Z0-9]{8,10}[A-Z]?$",
    "uen_pattern": "^[0-9]{8,9}[A-Z]$|^[A-Z][0-9]{8}[A-Z]$|^T[0-9]{2}[A-Z]{2}[0-9]{4}[A-Z]$",
    "postal_code_pattern": "^[0-9]{6}$",
    "required_fields": ["invoice_number", "issue_date", "currency_code", "seller_uen"]
  },

  "defaults": {
    "payment_terms": "Net 30 days",
    "contact_department": "Finance Department"
  },

  "special_rules": {
    "requires_issue_time": false,
    "requires_duty_stamp": false,
    "requires_fiscal_code": false,
    "invoice_now_network": true
  },

  "translations": {
    "invoice": "Tax Invoice",
    "credit_note": "Credit Note",
    "total": "Total",
    "tax": "GST"
  }
}
