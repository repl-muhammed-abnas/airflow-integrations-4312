        <mxCell id="gateway" value="&lt;b&gt;Backend Gateway (FastAPI)&lt;/b&gt;&#10;POST  /api/v1/rp/confirmedBookings/batches&#10;POST  /api/v1/rp/confirmedBookings&#10;PATCH /api/v1/rp/confirmedBookings/markPushed&#10;POST  /api/v1/rp/confirmedBookings/failures&#10;GET   /api/v1/rp/confirmedBookings/failures&#10;PATCH /api/v1/rp/confirmedBookings/failures/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11" vertex="1" parent="1">
