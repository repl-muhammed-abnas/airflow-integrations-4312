        </mxCell>

        <mxCell id="polaris" value="&lt;b&gt;Polaris (Replicon)&lt;/b&gt;&#10;GraphQL (POST /graphql):&#10;  • createTaskResourceUserAllocation&#10;  • updateTaskResourceUserAllocation (PARTIAL)&#10;  • putTaskResourceEstimate&#10;REST (POST /services/...):&#10;  • ImportService1.svc/BulkGetUsers3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="920" width="500" height="170" as="geometry" />
        </mxCell>

        <mxCell id="mssql" value="&lt;b&gt;MSSQL: dbo.rp_source&lt;/b&gt;&#10;Work queue filter:&#10;  outbound_pending_op IS NOT NULL&#10;  AND last_updated_date IN (cursor, upperBound]&#10;Per-row signal: ADD / UPDATE / DELETE&#10;markPushed clears the signal" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10" vertex="1" parent="1">
