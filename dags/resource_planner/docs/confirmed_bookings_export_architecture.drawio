        <mxCell id="c_capt" value="capture_page_conf&#10;(PythonOperator)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="220" height="60" as="geometry" />
